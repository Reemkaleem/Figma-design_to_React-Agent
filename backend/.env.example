# GitHub Copilot / Azure OpenAI-compatible key
# Get this from: https://github.com/settings/tokens (needs copilot access)
# Or use any OpenAI-compatible API key
GITHUB_COPILOT_API_KEY=your_key_here

# Optional: override the model (default: gpt-4o)
# MODEL=gpt-4o

# Optional: lower values are more deterministic (default: 0.15)
# MODEL_TEMPERATURE=0.15

# Optional: syntax self-healing retries (default: 3)
# MAX_RETRIES=3

# Optional: visual refinement rounds after syntax validation (default: 3)
# MAX_FIDELITY_ROUNDS=3

# Optional: target minimum fidelity score before stopping refinement (default: 94)
# TARGET_FIDELITY_SCORE=94

# Optional: cap for Figma summary context sent to model (default: 14000)
# MAX_DESIGN_JSON_CHARS=14000
